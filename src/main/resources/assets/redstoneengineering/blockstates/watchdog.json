{
  "multipart": [
    {"when": {"facing": "north"}, "apply": {"model": "redstoneengineering:block/watchdog"}},
    {"when": {"facing": "east"}, "apply": {"model": "redstoneengineering:block/watchdog", "y": 90}},
    {"when": {"facing": "south"}, "apply": {"model": "redstoneengineering:block/watchdog", "y": 180}},
    {"when": {"facing": "west"}, "apply": {"model": "redstoneengineering:block/watchdog", "y": 270}},

    {"when": {"facing": "north"}, "apply": {"model": "redstoneengineering:block/engineering_tx_marker"}},
    {"when": {"facing": "east"}, "apply": {"model": "redstoneengineering:block/engineering_tx_marker", "y": 90}},
    {"when": {"facing": "south"}, "apply": {"model": "redstoneengineering:block/engineering_tx_marker", "y": 180}},
    {"when": {"facing": "west"}, "apply": {"model": "redstoneengineering:block/engineering_tx_marker", "y": 270}},

    {"when": {"input_facing": "north"}, "apply": {"model": "redstoneengineering:block/engineering_rx_marker"}},
    {"when": {"input_facing": "east"}, "apply": {"model": "redstoneengineering:block/engineering_rx_marker", "y": 90}},
    {"when": {"input_facing": "south"}, "apply": {"model": "redstoneengineering:block/engineering_rx_marker", "y": 180}},
    {"when": {"input_facing": "west"}, "apply": {"model": "redstoneengineering:block/engineering_rx_marker", "y": 270}},

    {"when": {"timeout": "0|1|2|3"}, "apply": {"model": "redstoneengineering:block/config_segment_1"}},
    {"when": {"timeout": "1|2|3"}, "apply": {"model": "redstoneengineering:block/config_segment_2"}},
    {"when": {"timeout": "2|3"}, "apply": {"model": "redstoneengineering:block/config_segment_3"}},
    {"when": {"timeout": "3"}, "apply": {"model": "redstoneengineering:block/config_segment_4"}},

    {"when": {"output": "0"}, "apply": {"model": "redstoneengineering:block/watchdog_nominal_indicator"}},
    {"when": {"output": "15"}, "apply": {"model": "redstoneengineering:block/watchdog_timeout_indicator"}}
  ]
}
