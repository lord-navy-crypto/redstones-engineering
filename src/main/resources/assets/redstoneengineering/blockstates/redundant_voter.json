{
  "multipart": [
    {"when": {"facing": "north"}, "apply": {"model": "redstoneengineering:block/redundant_voter"}},
    {"when": {"facing": "east"}, "apply": {"model": "redstoneengineering:block/redundant_voter", "y": 90}},
    {"when": {"facing": "south"}, "apply": {"model": "redstoneengineering:block/redundant_voter", "y": 180}},
    {"when": {"facing": "west"}, "apply": {"model": "redstoneengineering:block/redundant_voter", "y": 270}},

    {"when": {"facing": "north"}, "apply": {"model": "redstoneengineering:block/engineering_tx_marker"}},
    {"when": {"facing": "east"}, "apply": {"model": "redstoneengineering:block/engineering_tx_marker", "y": 90}},
    {"when": {"facing": "south"}, "apply": {"model": "redstoneengineering:block/engineering_tx_marker", "y": 180}},
    {"when": {"facing": "west"}, "apply": {"model": "redstoneengineering:block/engineering_tx_marker", "y": 270}},

    {"when": {"input_facing": "north"}, "apply": {"model": "redstoneengineering:block/engineering_rx_marker"}},
    {"when": {"input_facing": "east"}, "apply": {"model": "redstoneengineering:block/engineering_rx_marker", "y": 90}},
    {"when": {"input_facing": "south"}, "apply": {"model": "redstoneengineering:block/engineering_rx_marker", "y": 180}},
    {"when": {"input_facing": "west"}, "apply": {"model": "redstoneengineering:block/engineering_rx_marker", "y": 270}},

    {"when": {"tolerance": "0|1|2|3"}, "apply": {"model": "redstoneengineering:block/config_segment_1"}},
    {"when": {"tolerance": "1|2|3"}, "apply": {"model": "redstoneengineering:block/config_segment_2"}},
    {"when": {"tolerance": "2|3"}, "apply": {"model": "redstoneengineering:block/config_segment_3"}},
    {"when": {"tolerance": "3"}, "apply": {"model": "redstoneengineering:block/config_segment_4"}}
  ]
}
