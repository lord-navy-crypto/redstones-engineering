{
  "multipart": [
    {
      "when": { "facing": "north" },
      "apply": { "model": "redstoneengineering:block/signal_analyzer" }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "redstoneengineering:block/signal_analyzer", "y": 90 }
    },
    {
      "when": { "facing": "south" },
      "apply": { "model": "redstoneengineering:block/signal_analyzer", "y": 180 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "redstoneengineering:block/signal_analyzer", "y": 270 }
    },
    {
      "when": { "facing": "up" },
      "apply": { "model": "redstoneengineering:block/signal_analyzer", "x": 270 }
    },
    {
      "when": { "facing": "down" },
      "apply": { "model": "redstoneengineering:block/signal_analyzer", "x": 90 }
    }
  ]
}
